{
  "name": "roomly",
  "version": "1.0.0",
  "private": true,
  "description": "Roomly - premium hotel management system (MERN)",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "server": "npm run start --prefix server",
    "client:build": "npm run build --prefix client",
    "test:server": "npm test --prefix server",
    "seed": "npm run seed --prefix server",
    "seed:reset": "npm run seed:reset --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
